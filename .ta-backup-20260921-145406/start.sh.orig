#!/usr/bin/env bash
#
# start.sh - Flask 应用一键守护脚本（含崩溃自重启）
# 用法:
#   ./start.sh start     # 后台启动（崩溃自动重启）
#   ./start.sh stop      # 停止
#   ./start.sh restart   # 重启
#   ./start.sh status    # 查看状态
#   ./start.sh logs      # 跟踪日志
#
set -o pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_DIR="$APP_DIR/.venv"
HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-8000}"
PID_FILE="$APP_DIR/.mysite.pid"
LOG_FILE="$APP_DIR/mysite.log"
REQ_FILE="$APP_DIR/requirements.txt"
ENV_FILE="$APP_DIR/.env"

# ---------- 颜色 ----------
# 坑：'\033[0;32m' 存的是「反斜杠 + 033」四个字面字符，而 bash 内建 echo 默认
# 不解释转义（不像 printf），于是原样打印出 "\033[0;32m[OK]\033[0m"。
# 正解：用 $'...'（ANSI-C quoting）在赋值时就把 \033 变成真正的 ESC 字符。
# 另外非终端（重定向到文件 / 管道）时干脆不上色，免得日志里全是乱码。
if [ -t 1 ]; then
  c_green=$'\033[0;32m'; c_red=$'\033[0;31m'; c_yellow=$'\033[0;33m'; c_reset=$'\033[0m'
else
  c_green=''; c_red=''; c_yellow=''; c_reset=''
fi
log()  { printf '%s\n' "${c_green}[OK]${c_reset} $*"; }
warn() { printf '%s\n' "${c_yellow}[!!]${c_reset} $*"; }
err()  { printf '%s\n' "${c_red}[ERR]${c_reset} $*"; }

usage() {
  echo "用法: $0 {start|stop|restart|status|logs}"
  exit 1
}

# ---------- 进程检测 ----------
is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# ---------- 准备运行环境（venv + 依赖） ----------
ensure_env() {
  if [ ! -d "$VENV_DIR" ]; then
    warn "未找到虚拟环境，正在创建 $VENV_DIR ..."
    python3 -m venv "$VENV_DIR"
  fi
  # shellcheck disable=SC1091
  . "$VENV_DIR/bin/activate"
  warn "安装/更新依赖 (requirements.txt) ..."
  pip install -q -r "$REQ_FILE" 2>&1 | tail -3
}

# ---------- 启动 ----------
start() {
  if is_running; then
    log "已在运行 (PID $(cat "$PID_FILE"))"
    return 0
  fi

  ensure_env

  # 载入 .env（数据库密码 / SECRET_KEY 等）
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
    log "已载入环境变量: $ENV_FILE"
  else
    warn "未找到 $ENV_FILE，数据库 / MiMo 等功能依赖环境变量，请创建 .env 或设置环境变量"
  fi
  SECRET_KEY="${SECRET_KEY:-change-me-in-production}"
  export SECRET_KEY HOST PORT

  log "启动 Flask 守护进程 (host=$HOST port=$PORT) ..."
  log "日志文件: $LOG_FILE"

  # nohup 脱离终端后台运行；内部 while 循环实现崩溃自重启
  nohup bash -c '
    . "'"$VENV_DIR"'/bin/activate"
    cd "'"$APP_DIR"'"
    while true; do
      echo "[$(date "+%Y-%m-%d %H:%M:%S")] >>> 启动 Flask (port='"$PORT"')" >> "'"$LOG_FILE"'"
      python -c "
import sys
sys.path.insert(0, \"'"$APP_DIR"'\")
from vercel_app.app import app
app.run(host=\"'"$HOST"'\", port=int('"$PORT"'), debug=False, use_reloader=False)
" >> "'"$LOG_FILE"'" 2>&1
      echo "[$(date "+%Y-%m-%d %H:%M:%S")] >>> Flask 已退出，3 秒后自动重启 ..." >> "'"$LOG_FILE"'"
      sleep 3
    done
  ' >/dev/null 2>&1 &
  echo $! > "$PID_FILE"

  # 等待确认
  sleep 2
  if is_running; then
    log "已启动 (守护 PID $(cat "$PID_FILE"))"
  else
    err "启动失败，请查看日志: $LOG_FILE"
    rm -f "$PID_FILE"
    exit 1
  fi
}

# ---------- 停止 ----------
stop() {
  if ! is_running; then
    warn "未运行"
    rm -f "$PID_FILE"
    return 0
  fi
  pid="$(cat "$PID_FILE")"
  log "停止守护进程 (PID $pid) ..."
  # 取进程组 ID，整体 kill（含 while 循环与 python 子进程）
  pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
  if [ -n "$pgid" ]; then
    kill -- -"$pgid" 2>/dev/null || true
  fi
  kill "$pid" 2>/dev/null || true
  # 兜底：按命令行特征清理可能残留的 python 进程
  pkill -f "vercel_app.app import app" 2>/dev/null || true
  rm -f "$PID_FILE"
  # 等端口释放
  sleep 1
  log "已停止"
}

# ---------- 状态 ----------
status() {
  if is_running; then
    log "运行中 (PID $(cat "$PID_FILE"))"
    if command -v curl >/dev/null 2>&1; then
      code=$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${PORT}/" 2>/dev/null || echo "无法连接")
      echo "    HTTP / -> $code"
    fi
  else
    warn "未运行"
  fi
}

logs() {
  if [ -f "$LOG_FILE" ]; then
    tail -f "$LOG_FILE"
  else
    err "日志文件不存在: $LOG_FILE"
  fi
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  logs)    logs ;;
  *)       usage ;;
esac
