<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 开机自启动：系统登录时运行 start.sh start，由脚本内部 while 循环负责崩溃重启 -->
  <key>Label</key>
  <string>com.mysite.flask</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zhao/Desktop/mysite/start.sh</string>
    <string>start</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zhao/Desktop/mysite</string>

  <!-- 登录时自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 脚本内部已自行崩溃重启，这里不交给 launchd 重复拉起 -->
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/zhao/Desktop/mysite/mysite.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zhao/Desktop/mysite/mysite.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 生产环境下改掉这个值，或用 .env 文件覆盖 -->
    <key>SECRET_KEY</key>
    <string>change-me-in-production</string>
  </dict>
</dict>
</plist>
