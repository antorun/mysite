# Flask 会话签名密钥——生产环境【必须】改成随机长字符串
# 可通过以下命令生成:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 监听地址与端口（可选，脚本默认 0.0.0.0:8000）
# HOST=0.0.0.0
# PORT=8000

# ===== 数据库（MySQL，必填）=====
# 部署到 Vercel 时在 Settings -> Environment Variables 配置以下变量。
# 注意：此文件仅作示例，请填写占位符，真实值通过部署平台或本地 .env 注入。
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ===== MiMo 聊天凭证（必填，用于 /mimo-chat-api 与 OpenAI 兼容接口）=====
# serviceToken 会过期，过期后需更新。
MIMO_PH=
MIMO_USER_ID=
MIMO_SERVICE_TOKEN=

# ===== NVIDIA NIM 代理凭证（可选，用于 /nvidia-chat-api）=====
NVIDIA_API_KEY=
